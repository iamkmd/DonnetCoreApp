@model IEnumerable<EmpApplication.Models.Student>
@{
    ViewData["Title"] = "Index";

}


<h2>Index</h2>
<p>


    <a asp-action="Create"> Create New</a>
   

<table class="table" border="1">
   <thead>
       <tr>
            <th>
                @Html.DisplayNameFor(model => model.id)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
        </tr>
     </thead>

     <tbody>

            @foreach(var e in Model)
            {
                   <tr>
                       <td>
                           @Html.DisplayFor(item => e.id)
                       </td>

                       <td>
                           @Html.DisplayFor(item => e.Name)
                       </td>

                       <td>
                           @Html.DisplayFor(item => e.City)
                       </td>

                       <td>
                           <a asp-action="Edit" asp-route-id="@e.id">Edit</a>
                           <a asp-action="Details" asp-route-id="@e.id">Details</a>
                           <a asp-action="Delete" asp-route-id="@e.id">Delete</a>
                       </td>
                   </tr>
            }


        </tbody>
    </table>
 </p>